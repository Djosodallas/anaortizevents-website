{
  "name": "anaortiz-events",
  // djosito214 Cloudflare account
  "account_id": "d14c810a16769ab0444144e184b8e0c7",
  "compatibility_date": "2026-11-01",
  "main": "worker.js",
  // Only reachable through anaortiz.events: no *.workers.dev URL and no
  // per-version preview URLs (worker.js also 301s any other host to www).
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve /investment, /contact, /vendors (same URLs as the old Squarespace site)
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Worker runs first so it can 301 anaortiz.events → www and handle /api/inquiry
    "run_worker_first": true
  },
  // Custom domains anaortiz.events + www.anaortiz.events are attached to this Worker
  // in the dashboard (Workers → anaortiz-events → Domains); wrangler's OAuth token
  // can't create their DNS records, so they're not listed here.
  // Contact form → Ana's inbox via Email Routing on anaortiz.events (destination verified).
  "send_email": [
    { "name": "INQUIRY_EMAIL", "destination_address": "anaortizevents@gmail.com" }
  ]
}
